# ─────────────────────────────────────────────
#  Insightify Backend – Environment Variables
#  Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

PORT=5000
# "development" enables request logging and disables the cron jobs
NODE_ENV=development

# MongoDB Atlas → Database → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/insightify

# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# GitHub personal access token (used for all GitHub API calls)
GITHUB_TOKEN=ghp_your_github_personal_access_token

# https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key
DEFAULT_CITY=Ajmer

# https://newsapi.org/account
NEWS_API_KEY=your_newsapi_key

# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional: override when Google retires the default model
# GEMINI_MODEL=gemini-2.0-flash

# Spotify Developer Dashboard → your app → Settings
# The redirect URI must also be listed under "Redirect URIs" there.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/api/spotify/callback

# Where Spotify login sends the user back to
FRONTEND_URL=http://localhost:5173
